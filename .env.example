# Copy to .env (local) and configure the same keys in Vercel project settings.
# Use a pooled connection string for DATABASE_URL and the direct (non-pooled) one for DIRECT_URL
# when your managed provider (Neon, Supabase, Prisma Postgres, RDS) offers both.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public&sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public&sslmode=require"
TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME_TEST?schema=public&sslmode=require"
APP_ENV="development"
